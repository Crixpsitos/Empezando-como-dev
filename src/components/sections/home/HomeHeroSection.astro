---
import NavLink from "../../common/NavLink.astro";
import Terminal from "../../terminal/Terminal.astro";


const currentYear = new Date().getFullYear();

---

<section
  class="min-h-150 md:min-h-175 flex flex-col lg:flex-row items-center justify-between gap-stack_xl py-stack_xl"
>
  <div class="w-full lg:w-1/2 flex flex-col gap-6 relative z-10">
    <div
      class="inline-flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant tracking-widest"
    >
      <span
        class="w-2 h-2 rounded-full bg-primary shadow-[0_0_8px_rgba(107,251,154,0.6)]"
      ></span>
      Personal Blog · {currentYear}
    </div>
    <h1
      class="font-display-lg text-[64px] md:text-[80px] lg:text-[90px] leading-[0.95] tracking-tighter font-bold"
    >
      Empezando <br />
      <span class="text-primary">como dev.</span>
    </h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-lg">
      Documentando el viaje de aprendizaje, desde los fundamentos hasta la
      complejidad del desarrollo moderno. Un registro público de victorias,
      errores y código crudo.
    </p>
    <div class="flex flex-wrap gap-4 mt-4 font-mono">
      <NavLink
        className="bg-custom-green-btn hover:bg-custom-green-btn-hover !text-black font-label-md text-label-md px-6 py-3 rounded-[10px] transition-colors flex items-center gap-2 shadow-[0_0_15px_rgba(74,222,128,0.15)] hover:shadow-[0_0_20px_rgba(74,222,128,0.25)]"
        href="/Articulos"
        isExternal={false}
      >
        Explorar artículos →
      </NavLink>
      <NavLink
        className="bg-transparent hover:bg-custom-hover text-custom-text border border-custom-border font-label-md text-label-md px-6 py-3 rounded-[10px] transition-colors flex items-center gap-2"
        href="/videos"
        isExternal={false}
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
        Ver videos
      </NavLink>
    </div>
  </div>
  <Terminal />
</section>
