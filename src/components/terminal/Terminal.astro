---
import { TerminalContent } from "./TerminalContent";
---

<div class="w-full lg:w-1/2 relative group">
  <div class="absolute inset-0 bg-primary/5 rounded-xl blur-xl group-hover:bg-primary/10 transition-colors duration-500"></div>
  <div class="relative bg-custom-input border border-custom-border rounded-xl shadow-[0_20px_60px_rgba(0,0,0,0.28)] overflow-hidden font-mono">
    <div class="flex items-center px-4 py-3 border-b border-custom-border bg-custom-card/50">
      <div class="flex gap-2">
        <div class="w-3 h-3 rounded-full bg-outline-variant/50"></div>
        <div class="w-3 h-3 rounded-full bg-outline-variant/50"></div>
        <div class="w-3 h-3 rounded-full bg-outline-variant/50"></div>
      </div>
      <div class="mx-auto text-xs text-on-surface-variant opacity-70">
        ~/empezando-como-dev
      </div>
    </div>
    <TerminalContent client:visible />
  </div>
</div>
